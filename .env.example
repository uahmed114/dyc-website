# The Zoho secrets now live on the Cloudflare Worker, not here:
#   worker/.dev.vars.example (local) and `npx wrangler secret put` (live).
# See README.md → Deploying, and docs/ZOHO_SETUP.md.
#
# For local testing against `npm run dev` in worker/, put this in
# .env.development.local (not .env.local, which also affects production builds):
NEXT_PUBLIC_CONSULTATION_URL=http://localhost:8787
