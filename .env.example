# Copy this file to .env.local (never commit .env.local) and fill in the values.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
# Step-by-step instructions: docs/ZOHO_SETUP.md

# Zoho data centre your account lives in: com, eu, in, com.au, jp, ca
ZOHO_DC=com

# From your Self Client at https://api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# The spreadsheet: the ID from its Zoho Sheet URL, and the tab name
ZOHO_SHEET_RESOURCE_ID=
ZOHO_SHEET_WORKSHEET=Leads
ZOHO_SHEET_HEADER_ROW=1
